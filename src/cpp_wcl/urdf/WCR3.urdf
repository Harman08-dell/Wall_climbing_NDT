<?xml version="1.0"?>
<robot name="four_crawler_robot">

  <!-- ===== Materials ===== -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.9 1"/>
  </material>

  <!-- ===== Base ===== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.5 0.4 0.15"/>
      </geometry>
      <material name="white"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.15"/>
      <geometry>
        <box size="0.5 0.4 0.15"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="10"/>
      <origin xyz="0 0 0.15"/>
      <inertia ixx="0.3" ixy="0" ixz="0"
               iyy="0.3" iyz="0"
               izz="0.3"/>
    </inertial>
  </link>

  <!-- ===== CRAWLER TEMPLATE ===== -->

  <!-- FRONT LEFT -->
  <link name="crawler_fl">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="-0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
    </collision>
  </link>

  <!-- FRONT RIGHT -->
  <link name="crawler_fr">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="-0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
    </collision>
  </link>

  <!-- REAR LEFT -->
  <link name="crawler_rl">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="-0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
    </collision>
  </link>

  <!-- REAR RIGHT -->
  <link name="crawler_rr">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <visual>
      <origin xyz="-0.175 0 0.05"/>
      <geometry><cylinder radius="0.05" length="0.08"/></geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><box size="0.35 0.08 0.1"/></geometry>
    </collision>
  </link>

  <!-- ===== JOINTS ===== -->

  <joint name="joint_fl" type="fixed">
    <parent link="base_link"/>
    <child link="crawler_fl"/>
    <origin xyz="0.22 0.25 0"/>
  </joint>

  <joint name="joint_fr" type="fixed">
    <parent link="base_link"/>
    <child link="crawler_fr"/>
    <origin xyz="0.22 -0.25 0"/>
  </joint>

  <joint name="joint_rl" type="fixed">
    <parent link="base_link"/>
    <child link="crawler_rl"/>
    <origin xyz="-0.22 0.25 0"/>
  </joint>

  <joint name="joint_rr" type="fixed">
    <parent link="base_link"/>
    <child link="crawler_rr"/>
    <origin xyz="-0.22 -0.25 0"/>
  </joint>

  <!-- ===== GAZEBO FRICTION FOR TRACKS ===== -->

  <gazebo reference="crawler_fl">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="crawler_fr">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="crawler_rl">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

  <gazebo reference="crawler_rr">
    <mu1>2.0</mu1>
    <mu2>2.0</mu2>
  </gazebo>

</robot>
