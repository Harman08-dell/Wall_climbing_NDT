<?xml version="1.0"?>
<robot name="wall_climber_robot">

  <material name="Black">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="aluminum">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="transparent_shell">
    <color rgba="0.0 0.5 1.0 0.4"/> </material>
  <material name="magnet_red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.05"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="fl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fl_sphere_shell"/>
    <origin xyz="0.15 0.2 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="fl_sphere_shell">
    <visual>
      <geometry><sphere radius="0.0635"/></geometry>
      <material name="transparent_shell"/>
    </visual>
  </link>
  <joint name="fl_magnet_servo" type="revolute">
    <parent link="fl_sphere_shell"/>
    <child link="fl_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <link name="fl_magnet">
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="0.06 0.04 0.02"/></geometry>
      <material name="magnet_red"/>
    </visual>
  </link>

  <joint name="fr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fr_sphere_shell"/>
    <origin xyz="0.15 -0.2 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="fr_sphere_shell">
    <visual>
      <geometry><sphere radius="0.0635"/></geometry>
      <material name="transparent_shell"/>
    </visual>
  </link>
  <joint name="fr_magnet_servo" type="revolute">
    <parent link="fr_sphere_shell"/>
    <child link="fr_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <link name="fr_magnet">
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="0.06 0.04 0.02"/></geometry>
      <material name="magnet_red"/>
    </visual>
  </link>

  <joint name="rl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rl_sphere_shell"/>
    <origin xyz="-0.15 0.2 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rl_sphere_shell">
    <visual>
      <geometry><sphere radius="0.0635"/></geometry>
      <material name="transparent_shell"/>
    </visual>
  </link>
  <joint name="rl_magnet_servo" type="revolute">
    <parent link="rl_sphere_shell"/>
    <child link="rl_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <link name="rl_magnet">
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="0.06 0.04 0.02"/></geometry>
      <material name="magnet_red"/>
    </visual>
  </link>

  <joint name="rr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rr_sphere_shell"/>
    <origin xyz="-0.15 -0.2 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rr_sphere_shell">
    <visual>
      <geometry><sphere radius="0.0635"/></geometry>
      <material name="transparent_shell"/>
    </visual>
  </link>
  <joint name="rr_magnet_servo" type="revolute">
    <parent link="rr_sphere_shell"/>
    <child link="rr_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1.0"/>
  </joint>
  <link name="rr_magnet">
    <visual>
      <origin xyz="0 0 -0.05"/>
      <geometry><box size="0.06 0.04 0.02"/></geometry>
      <material name="magnet_red"/>
    </visual>
  </link>

</robot>