<?xml version="1.0"?>
<robot name="wall_tracked_crawler">

  <material name="chassis_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="track_black"><color rgba="0.1 0.1 0.1 1.0"/></material>
  <material name="sprocket_silver"><color rgba="0.6 0.6 0.6 1.0"/></material>
  <material name="magnet_red"><color rgba="0.8 0.0 0.0 1.0"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.25 0.06"/></geometry>
      <material name="chassis_grey"/>
    </visual>
  </link>

  <joint name="fl_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fl_track_belt"/>
    <origin xyz="0.15 0.18 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="fl_track_belt">
    <visual>
      <geometry><box size="0.25 0.05 0.12"/></geometry>
      <material name="track_black"/>
    </visual>
  </link>

  <joint name="fl_magnet_servo" type="revolute">
    <parent link="fl_track_belt"/>
    <child link="fl_magnet"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="1.0"/>
  </joint>

  <link name="fl_magnet">
    <visual>
      <origin xyz="0 0 -0.05"/> <geometry><box size="0.1 0.04 0.01"/></geometry>
      <material name="magnet_red"/>
    </visual>
  </link>

  <joint name="fr_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fr_track_belt"/>
    <origin xyz="0.15 -0.18 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="fr_track_belt">
    <visual>
      <geometry><box size="0.25 0.05 0.12"/></geometry>
      <material name="track_black"/>
    </visual>
  </link>
  <joint name="fr_magnet_servo" type="revolute">
    <parent link="fr_track_belt"/>
    <child link="fr_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="1.0"/>
  </joint>
  <link name="fr_magnet"><visual><origin xyz="0 0 -0.05"/><geometry><box size="0.1 0.04 0.01"/></geometry><material name="magnet_red"/></visual></link>

  <joint name="rl_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rl_track_belt"/>
    <origin xyz="-0.15 0.18 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rl_track_belt">
    <visual>
      <geometry><box size="0.25 0.05 0.12"/></geometry>
      <material name="track_black"/>
    </visual>
  </link>
  <joint name="rl_magnet_servo" type="revolute">
    <parent link="rl_track_belt"/>
    <child link="rl_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="1.0"/>
  </joint>
  <link name="rl_magnet"><visual><origin xyz="0 0 -0.05"/><geometry><box size="0.1 0.04 0.01"/></geometry><material name="magnet_red"/></visual></link>

  <joint name="rr_track_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rr_track_belt"/>
    <origin xyz="-0.15 -0.18 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <link name="rr_track_belt">
    <visual>
      <geometry><box size="0.25 0.05 0.12"/></geometry>
      <material name="track_black"/>
    </visual>
  </link>
  <joint name="rr_magnet_servo" type="revolute">
    <parent link="rr_track_belt"/>
    <child link="rr_magnet"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.78" upper="0.78" effort="10" velocity="1.0"/>
  </joint>
  <link name="rr_magnet"><visual><origin xyz="0 0 -0.05"/><geometry><box size="0.1 0.04 0.01"/></geometry><material name="magnet_red"/></visual></link>

</robot>