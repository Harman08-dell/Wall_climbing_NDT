<?xml version="1.0"?>
<!--http://wiki.ros.org/urdf/XML/link--> 
<robot name = "simple_robot">
    <link name ="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.3" length="0.1"/>
            </geometry>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <material name = "blue">
                <color rgba = "0 1 0 1"/>
            </material>
            
        </visual>

    </link>
    <joint name = "joint_1" type = "revolute">
        <parent link="base_link"/>
        <child link="first_link"/>
        <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-1.2" upper="1.2" effort="300" velocity="2.0"/>
        
        
        
        
    </joint>
    <link name ="first_link">
        <visual>
            <geometry>
                <cylinder radius="0.08" length="0.5"/>
            </geometry>
            <origin xyz="0.0 0.0 0.25" rpy="0.0 0.0 0.0"/>
            <material name = "yellow">
                <color rgba = "1 1 0 1"/>
            </material>
            
        </visual>

    </link>
    <joint name = "joint_2" type = "prismatic">
        <parent link="first_link"/>
        <child link="seconed_link"/>
        <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
        <axis xyz="0.0 1.0 0.0"/>
        <limit lower="-5" upper="5" effort="300" velocity="2.0"/>
        
        
        
        
    </joint>
    <link name ="seconed_link">
        <visual>
            <geometry>
                <box size="0.2 0.7 0.1"/>
            </geometry>                    
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
            <material name = "red">
                <color rgba = "0 0 1 1"/>
            </material>
            
        </visual>

    </link>


</robot>